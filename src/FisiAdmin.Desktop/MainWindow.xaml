<Window x:Class="FisiAdmin.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FISI Admin Suite" Height="760" Width="1280" Background="#0B1018" Foreground="#E5E7EB">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#101722" BorderBrush="#253044" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="18"><TextBlock Text="FISI Admin Suite" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Enterprise Console" Foreground="#94A3B8" Margin="0,4,0,18"/><Button Content="Dashboard" Click="Dashboard_Click"/><Button Content="Benutzer" Click="Users_Click"/><Button Content="Gruppen"/><Button Content="Active Directory"/><Button Content="PowerShell"/><Button Content="Audit Logs"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#253044" BorderThickness="0,0,0,1" Padding="20,12"><DockPanel><TextBox x:Name="SearchBox" Width="420" Height="36" VerticalContentAlignment="Center" Text=""/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="IdentityText" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Abmelden" Click="Logout_Click"/><Button Content="Aktualisieren" Click="Refresh_Click"/></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Row="1"><StackPanel Margin="28"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="API wird geladen..." Foreground="#94A3B8" Margin="0,5,0,20"/><UniformGrid x:Name="Metrics" Columns="4" Margin="0,0,0,20"/><DataGrid x:Name="MainGrid" AutoGenerateColumns="True" MinHeight="420" Background="#111827" Foreground="#111827"/></StackPanel></ScrollViewer></Grid></Grid>
</Window>